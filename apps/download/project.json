{
  "name": "download",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/download/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/download",
        "index": "apps/download/src/index.html",
        "browser": "apps/download/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/download/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          "apps/download/src/favicon.ico",
          "apps/download/src/assets",
          {
            "glob": "**/*",
            "input": "shared_assets/",
            "output": "./assets/"
          }
        ],
        "styles": ["./node_modules/@angular/material/prebuilt-themes/indigo-pink.css", "apps/download/src/styles.scss"],
        "scripts": []
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/download/src/environments/environment.ts",
              "with": "apps/download/src/environments/environment.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "200kb",
              "maximumError": "250kb"
            }
          ],
          "outputHashing": "all",
          "baseHref": "$APP_BASE_HREF"
        },
        "development": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "1mb",
              "maximumError": "2mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "200kb",
              "maximumError": "250kb"
            }
          ],
          "outputHashing": "all"
        }
      },
      "defaultConfiguration": ""
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "configurations": {
        "production": {
          "buildTarget": "download:build:production"
        },
        "development": {
          "buildTarget": "download:build:development"
        }
      },
      "defaultConfiguration": "development"
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "download:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/download/jest.config.ts"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "download:build",
        "port": 4200,
        "staticFilePath": "dist/apps/download/browser",
        "spa": true
      }
    }
  }
}
