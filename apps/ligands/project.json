{
  "name": "ligands",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/ligands/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/ligands",
        "browser": "apps/ligands/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/ligands/tsconfig.app.json",
        "inlineStyleLanguage": "scss",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/ligands/src/assets",
            "output": "assets"
          }
        ],
        "styles": ["@angular/material/prebuilt-themes/indigo-pink.css", "apps/ligands/src/styles.scss"],
        "scripts": [],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/core/src/lib/styles"]
        },
        "server": "apps/ligands/src/main.server.ts",
        "prerender": false,
        "externalDependencies": ["xhr2"],
        "ssr": {
          "entry": "apps/ligands/src/server.ts"
        }
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/ligands/src/environments/environment.ts",
              "with": "apps/ligands/src/environments/environment.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "4mb",
              "maximumError": "6mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "200kb",
              "maximumError": "400kb"
            }
          ],
          "aot": true,
          "extractLicenses": true,
          "namedChunks": false,
          "optimization": true,
          "sourceMap": true,
          "outputHashing": "all",
          "baseHref": "/pdbe-srv/pdbechem/chemicalCompound/",
          "deployUrl": "/pdbe-srv/pdbechem/chemicalCompound/"
        },
        "development": {
          "aot": true,
          "extractLicenses": true,
          "namedChunks": false,
          "optimization": true,
          "sourceMap": true,
          "outputHashing": "all",
          "baseHref": "/pdbe-srv/pdbechem/chemicalCompound/",
          "deployUrl": "/pdbe-srv/pdbechem/chemicalCompound/"
        },
        "local": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "development"
    },
    "serve": {
      "continuous": true,
      "executor": "@angular/build:dev-server",
      "options": {
        "buildTarget": "ligands:build:local",
        "port": 4400
      },
      "configurations": {
        "production": {
          "buildTarget": "ligands:build:production"
        },
        "development": {
          "buildTarget": "ligands:build:development"
        },
        "local": {
          "buildTarget": "ligands:build:local"
        }
      },
      "defaultConfiguration": "local"
    },
    "extract-i18n": {
      "executor": "@angular/build:extract-i18n",
      "options": {
        "buildTarget": "ligands:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint"
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/ligands/jest.config.ts",
        "tsConfig": "apps/ligands/tsconfig.spec.json"
      }
    },
    "serve-static": {
      "continuous": true,
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "ligands:build",
        "port": 4200,
        "staticFilePath": "dist/apps/ligands/browser",
        "spa": true
      }
    }
  }
}
