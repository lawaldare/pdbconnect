{
  "name": "connect",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "pdbc",
  "sourceRoot": "apps/connect/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-devkit/build-angular:browser",
      "outputs": ["{options.outputPath}"],
      "options": {
        "outputPath": "dist/apps/connect",
        "index": "apps/connect/src/index.html",
        "main": "apps/connect/src/main.ts",
        "polyfills": ["zone.js"],
        "tsConfig": "apps/connect/tsconfig.app.json",
        "assets": [
          "apps/connect/src/favicon.ico",
          "apps/connect/src/assets",
          {
            "glob": "**/*",
            "input": "shared_assets/",
            "output": "./assets/"
          },
          {
            "glob": "**/*",
            "input": "external/typescript-solr-manager/build",
            "output": "./assets/typescript-solr-manager"
          }
        ],
        "styles": [
          "./node_modules/leaflet/dist/leaflet.css",
          "./node_modules/leaflet.markercluster/dist/MarkerCluster.css",
          "./node_modules/leaflet.markercluster/dist/MarkerCluster.Default.css",
          "@angular/material/prebuilt-themes/indigo-pink.css",
          "apps/connect/src/styles.scss"
        ],
        "scripts": ["external/typescript-solr-manager/build/solr-core.js", "external/typescript-solr-manager/build/solr-pdbe.js"],
        "stylePreprocessorOptions": {
          "includePaths": ["libs/core/src/lib/styles"]
        }
      },
      "configurations": {
        "production": {
          "fileReplacements": [
            {
              "replace": "apps/connect/src/environments/environment.ts",
              "with": "apps/connect/src/environments/environment.prod.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "4mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "200kb",
              "maximumError": "400kb"
            }
          ],
          "aot": true,
          "buildOptimizer": true,
          "extractLicenses": true,
          "namedChunks": false,
          "optimization": true,
          "sourceMap": true,
          "vendorChunk": false,
          "outputHashing": "all",
          "baseHref": "/pdbe/entry/"
        },
        "staging": {
          "fileReplacements": [
            {
              "replace": "apps/connect/src/environments/environment.ts",
              "with": "apps/connect/src/environments/environment.staging.ts"
            }
          ],
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "3mb",
              "maximumError": "5mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "200kb",
              "maximumError": "400kb"
            }
          ],
          "aot": true,
          "buildOptimizer": true,
          "extractLicenses": true,
          "namedChunks": false,
          "optimization": true,
          "sourceMap": true,
          "vendorChunk": false,
          "outputHashing": "all",
          "baseHref": "/pdbe/entry/"
        },
        "development": {
          "aot": true,
          "buildOptimizer": true,
          "extractLicenses": true,
          "namedChunks": false,
          "optimization": true,
          "sourceMap": true,
          "vendorChunk": false,
          "outputHashing": "all",
          "baseHref": "/pdbe/entry/"
        },
        "local": {
          "buildOptimizer": false,
          "optimization": false,
          "vendorChunk": true,
          "extractLicenses": false,
          "sourceMap": true,
          "namedChunks": true
        }
      },
      "defaultConfiguration": "development"
    },
    "serve": {
      "executor": "@angular-devkit/build-angular:dev-server",
      "options": {
        "buildTarget": "connect:build:local"
      },
      "configurations": {
        "production": {
          "buildTarget": "connect:build:production"
        },
        "development": {
          "buildTarget": "connect:build:development"
        }
      },
      "defaultConfiguration": ""
    },
    "extract-i18n": {
      "executor": "@angular-devkit/build-angular:extract-i18n",
      "options": {
        "buildTarget": "connect:build"
      }
    },
    "lint": {
      "executor": "@nx/eslint:lint",
      "outputs": ["{options.outputFile}"]
    },
    "test": {
      "executor": "@nx/jest:jest",
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"],
      "options": {
        "jestConfig": "apps/connect/jest.config.ts"
      }
    },
    "serve-static": {
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "connect:build"
      }
    }
  }
}
